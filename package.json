{
  "name": "kanvas",
  "private": true,
  "version": "0.4.0-beta.1",
  "description": "KANVAS desktop visual management and organization app",
  "author": "KAOS",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "electron:dev": "node electron/run-electron-vite-dev.cjs",
    "electron:build": "npm run build && electron-vite build",
    "electron:pack": "npm run electron:package",
    "electron:package": "npm run electron:build && electron-builder --dir --config electron-builder.config.cjs",
    "electron:installer": "npm run electron:build && npm run electron:verify-assets && electron-builder --win nsis --config electron-builder.config.cjs -p never",
    "electron:installer:beta": "node scripts/verify-release-config.mjs beta && npm run typecheck && npm run test:release && npm run electron:build && npm run electron:verify-assets && node scripts/build-electron-installer.mjs beta && node scripts/verify-electron-release-artifacts.mjs beta",
    "electron:installer:stable": "node scripts/verify-release-config.mjs stable && npm run typecheck && npm run test:release && npm run electron:build && npm run electron:verify-assets && node scripts/build-electron-installer.mjs stable && node scripts/verify-electron-release-artifacts.mjs stable",
    "electron:publish:beta": "npm run release:beta",
    "electron:publish:stable": "npm run release:stable",
    "electron:verify-assets": "node scripts/verify-electron-assets.mjs",
    "release:check": "node scripts/verify-release-config.mjs",
    "release:beta": "npm run electron:installer:beta && node scripts/upload-supabase-release.mjs beta",
    "release:stable": "npm run electron:installer:stable && node scripts/upload-supabase-release.mjs stable",
    "lint": "eslint .",
    "lint:anti-patterns": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run --config vitest.release.config.ts",
    "test:release": "vitest run --config vitest.release.config.ts",
    "test:legacy": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:anti-patterns": "vitest run src/test/anti-pattern-detection.test.ts src/test/runtime-schema-validation.test.ts src/test/eslint-anti-patterns.test.ts",
    "validate:architecture": "npm run lint:anti-patterns && npm run test:anti-patterns",
    "migrate": "tsx src/scripts/migrateToCanonical.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.83.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.4.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "embla-carousel-react": "^8.6.0",
    "fast-average-color": "^9.5.0",
    "input-otp": "^1.4.2",
    "jose": "^6.1.3",
    "jszip": "^3.10.1",
    "lodash": "^4.17.23",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-color": "^2.19.3",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "uuid": "^14.0.0",
    "vaul": "^0.9.9",
    "vite": "^7.3.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.0.2",
    "msw": "^2.12.10",
    "supabase": "^2.102.0",
    "tsx": "^4.19.0",
    "vitest": "^3.2.4"
  }
}
