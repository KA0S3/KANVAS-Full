# Root desktop app and release tooling.
# Copy to .env for public Vite desktop renderer flags.
# Copy private local-only values to .env.local or set them in your shell/CI.

# Desktop renderer feature flags. These are bundled into the app when prefixed with VITE_.
VITE_USE_SUPABASE=false
VITE_USE_SUPABASE_AUTH=false
VITE_APP_NAME=KANVAS

# Optional only if cloud sync/auth is enabled inside the desktop renderer.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local release upload tooling only. Never put these in website env or Electron renderer code.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kanvas-desktop-releases

# Optional local build-time override for electron-builder metadata.
# Packaged app update checks normally use the licensed Supabase Edge Function feed.
KANVAS_UPDATE_BASE_URL=

# Optional Electron main-process overrides for local packaged testing.
# Production defaults are already in electron/licensing/licenseService.ts.
KANVAS_ACTIVATION_URL=https://www.kanvas-it.com/desktop/activate
KANVAS_LICENSE_API_URL=https://hzngfqebklzhnwkcmgto.supabase.co/functions/v1
